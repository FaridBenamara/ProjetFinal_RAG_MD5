{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python -m src.build_corpus && python -m src.indexer"
  },
  "deploy": {
    "startCommand": "gunicorn src.app:app --workers 1 --threads 4 --timeout 120 --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
}
